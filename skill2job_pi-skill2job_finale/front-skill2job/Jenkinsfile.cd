pipeline {
    agent any
    stages {
        stage('Import Image to Kubernetes') {
            steps {
                sh '''
                    docker save azizl/frontend:latest | sudo ctr -n k8s.io images import -
                '''
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl rollout restart deployment/frontend-deployment
                    kubectl rollout status deployment/frontend-deployment --timeout=120s
                '''
            }
        }
        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "=== Pods Status ==="
                    kubectl get pods -l app=frontend
                    echo "=== Service Status ==="
                    kubectl get service frontend-service
                '''
            }
        }
    }
    post {
        success {
            echo 'Frontend deployment to Kubernetes successful!'
        }
        failure {
            echo 'Frontend deployment failed!'
        }
    }
}
