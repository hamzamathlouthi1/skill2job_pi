pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'klibimayssa/gestion-exams'
        K8S_NAMESPACE = 'default'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
        HOST_IP = '192.168.158.131'
    }

    parameters {
        string(
            name: 'BUILD_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy (use CI build number)'
        )
    }

    stages {

        stage('Deploy to Docker') {
            steps {
                sh """
                    docker network create skill2job-network || true

                    docker start mysql || docker run -d \
                        --name mysql \
                        --network skill2job-network \
                        -e MYSQL_ROOT_PASSWORD=root \
                        -e MYSQL_DATABASE=exams_db \
                        -p 3306:3306 \
                        mysql:8.0

                    sleep 20

                    docker stop exams-service || true
                    docker rm   exams-service || true

                    docker run -d \
                        --name exams-service \
                        -p 8082:8082 \
                        -e SPRING_DATASOURCE_URL='jdbc:mysql://mysql:3306/exams_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true' \
                        -e SPRING_DATASOURCE_USERNAME=root \
                        -e SPRING_DATASOURCE_PASSWORD=root \
                        -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka \
                        -e SERVER_PORT=8082 \
                        -e MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus \
                        -e MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true \
                        --network skill2job-network \
                        ${DOCKER_IMAGE}:${params.BUILD_TAG}
                """
            }
        }

        stage('Health Check') {
            steps {
                script {
                    retry(10) {
                        sh 'sleep 10'
                        sh 'curl -f http://exams-service:8082/actuator/health'
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    sh '''
                        kubectl create namespace default || true

                        cat <<MANIFEST | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: exams-service
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: exams-service
  template:
    metadata:
      labels:
        app: exams-service
    spec:
      containers:
      - name: exams-service
        image: klibimayssa/gestion-exams:latest
        imagePullPolicy: Always
        ports:
        - containerPort: 8082
        env:
        - name: SPRING_DATASOURCE_URL
          value: "jdbc:mysql://192.168.158.131:3306/exams_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
        - name: SPRING_DATASOURCE_USERNAME
          value: "root"
        - name: SPRING_DATASOURCE_PASSWORD
          value: "root"
        - name: EUREKA_CLIENT_SERVICEURL_DEFAULTZONE
          value: "http://192.168.158.131:8761/eureka"
        - name: SERVER_PORT
          value: "8082"
        - name: MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE
          value: "health,info,prometheus"
        - name: MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED
          value: "true"
        readinessProbe:
          httpGet:
            path: /actuator/health
            port: 8082
          initialDelaySeconds: 60
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /actuator/health
            port: 8082
          initialDelaySeconds: 90
          periodSeconds: 20
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: exams-service
  namespace: default
spec:
  selector:
    app: exams-service
  ports:
    - protocol: TCP
      port: 8082
      targetPort: 8082
      nodePort: 30082
  type: NodePort
MANIFEST

                        kubectl rollout status deployment/exams-service -n default --timeout=180s
                    '''
                }
            }
        }

        stage('Verify Kubernetes Deployment') {
            steps {
                script {
                    sh """
                        echo "=== Pods ==="
                        kubectl get pods -n ${K8S_NAMESPACE} -l app=exams-service

                        echo "=== Service ==="
                        kubectl get svc -n ${K8S_NAMESPACE} exams-service

                        echo "=== Deployment ==="
                        kubectl get deployment -n ${K8S_NAMESPACE} exams-service
                    """
                }
            }
        }

        stage('Verify Traefik Routing') {
            steps {
                script {
                    try {
                        retry(3) {
                            sh 'sleep 5'
                            sh 'curl -f http://traefik:81/api/exams/actuator/health'
                        }
                    } catch (e) {
                        echo '⚠️ Traefik not available, skipping...'
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ DEPLOYMENT SUCCESSFUL!'
            echo "Deployed image    : ${DOCKER_IMAGE}:${params.BUILD_TAG}"
            echo 'Exams API         : http://localhost:8082'
            echo 'Via Traefik       : http://localhost:81/api/exams'
            echo 'Traefik Dashboard : http://localhost:8081/dashboard/'
            echo 'Prometheus        : http://localhost:9091'
            echo 'Grafana           : http://localhost:3001'
            echo 'Kubernetes        : kubectl get pods -n default'
        }
        failure {
            script {
                sh 'docker logs exams-service || true'
                sh 'kubectl describe pod -n default -l app=exams-service || true'
                sh 'kubectl logs -n default -l app=exams-service || true'
            }
        }
    }
}
