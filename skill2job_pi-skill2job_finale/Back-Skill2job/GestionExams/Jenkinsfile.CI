  pipeline {
     agent any

    environment {
        DOCKER_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN  = credentials('new_token')  
        SERVICE_NAME  = 'gestion-exams'
        DOCKER_IMAGE  = 'klibimayssa/gestion-exams'
    }

    tools {
        maven 'Maven-3'
        jdk   'JDK-21'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // mvn package = compile + test + create jar
        stage('Unit Tests & Package') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job/GestionExams') {
                    sh 'mvn clean package -U -Daether.syncContext.named.factory=noop'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'skill2job_pi-skill2job_finale/Back-Skill2job/GestionExams/target/surefire-reports/*.xml'
                }
            }
        }
stage('SonarQube Analysis') {
    steps {
        dir('skill2job_pi-skill2job_finale/Back-Skill2job/GestionExams') {
            sh """
                mvn sonar:sonar \
                    -Dsonar.projectKey=gestion-exams \
                    -Dsonar.host.url=http://sonarqube:9000 \
                    -Dsonar.token=sqa_9e38a4d8c62420d1a46292ea1b75fbaf1d0d54e5 \
                    -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
            """
        }
    }
}

        // jar already built by mvn package above
        stage('Build Docker Image') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    sh """
                        docker build \
                            -f GestionExams/Dockerfile \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    echo ${DOCKER_CREDS_PSW} | docker login \
                        -u ${DOCKER_CREDS_USR} \
                        --password-stdin
                    docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
        }
    }

    post {
        success {
            echo '✅ CI PASSED — Image pushed to DockerHub.'
            echo "Image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"
            // Trigger CD with the build number
            build job: 'gestion-exams-CD',
                  parameters: [string(name: 'BUILD_TAG', value: "${BUILD_NUMBER}")],
                  wait: false
        }
        failure {
            echo '❌ CI FAILED — Deployment will not proceed.'
        }
        always {
            sh 'docker logout || true'
        }
    }
}
