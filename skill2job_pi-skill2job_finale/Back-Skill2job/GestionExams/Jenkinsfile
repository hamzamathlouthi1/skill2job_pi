pipeline {
    agent any
    
    environment {
        DOCKER_CREDS = credentials('dockerhub-credentials')
        GITHUB_TOKEN = credentials('github-credentials')
        SERVICE_NAME = 'gestion-exams'
        DOCKER_IMAGE = 'klibimayssa/gestion-exams'
    }
    
    tools {
        maven 'Maven-3'
        jdk 'JDK-21'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Unit Tests') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job/GestionExams') {
                    sh 'mvn clean test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'skill2job_pi-skill2job_finale/Back-Skill2job/GestionExams/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    sh """
                        docker build \
                            -f GestionExams/Dockerfile \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    """
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                sh """
                    echo ${DOCKER_CREDS_PSW} | docker login \
                        -u ${DOCKER_CREDS_USR} \
                        --password-stdin
                    docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
        }
        
        stage('Deploy') {
            steps {
                sh """
                    docker network create skill2job-network || true
                    docker stop exams-service || true
                    docker rm exams-service || true
                    docker run -d \
                        --name exams-service \
                        -p 8082:8082 \
                        -e SPRING_DATASOURCE_URL='jdbc:mysql://mysql:3306/exams_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true' \
                        -e SPRING_DATASOURCE_USERNAME=root \
                        -e SPRING_DATASOURCE_PASSWORD=root \
                        -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka \
                        -e SERVER_PORT=8082 \
                        -e MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus \
                        -e MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true \
                        --network skill2job-network \
                        ${DOCKER_IMAGE}:latest
                """
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    retry(10) {
                        sh 'sleep 10'
                        sh 'curl -f http://exams-service:8082/actuator/health'
                    }
                }
            }
        }
        
        stage('Verify Traefik Routing') {
            steps {
                script {
                    retry(5) {
                        sh 'sleep 5'
                        sh 'curl -f http://traefik:81/api/exams/actuator/health'
                    }
                }
            }
        }
    }  // ← closes stages
    
    post {
        success {
            echo '✅ DEPLOYMENT SUCCESSFUL!'
            echo 'Exams API: http://localhost:8082'
            echo 'Via Traefik: http://localhost:81/api/exams'
            echo 'Traefik Dashboard: http://localhost:8081/dashboard/'
            echo 'Prometheus: http://localhost:9091'
            echo 'Grafana: http://localhost:3001'
        }
        failure {
            echo '❌ Build failed! Check Jenkins logs.'
        }
        always {
            sh 'docker logout || true'
        }
    }
}  // ← closes pipeline
