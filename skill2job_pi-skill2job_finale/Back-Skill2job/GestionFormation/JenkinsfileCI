pipeline {
    agent any
    environment {
        DOCKERHUB_IMAGE = 'souhakhelifi/gestionformation'
        NEXUS_IMAGE     = '192.168.161.129:8082/gestionformation'
    }
    tools {
        maven 'Maven'
        jdk   'JDK17'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Check Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim()
                    echo "Changed files:\n${changedFiles}"
                    if (!changedFiles.contains('Back-Skill2job/GestionFormation/')) {
                        echo "No changes in GestionFormation — skipping pipeline."
                        currentBuild.result = 'NOT_BUILT'
                        error("No relevant changes detected.")
                    }
                }
            }
        }
        stage('Build') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job/GestionFormation') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Code Quality — SonarQube') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job/GestionFormation') {
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            sh '''
                                mvn sonar:sonar \
                                  -Dsonar.projectKey=gestionformation-backend \
                                  -Dsonar.projectName="GestionFormation Backend" \
                                  -Dsonar.host.url=http://192.168.161.129:9000 \
                                  -Dsonar.login=${SONAR_TOKEN}
                            '''
                        }
                    }
                }
            }
        }
        stage('Docker Build & Push') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        ),
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )
                    ]) {
                        sh '''
                            docker build -f GestionFormation/Dockerfile \
                              -t ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} \
                              -t ${DOCKERHUB_IMAGE}:latest .
                            docker tag ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} ${NEXUS_IMAGE}:${BUILD_NUMBER}
                            docker tag ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} ${NEXUS_IMAGE}:latest
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            docker push ${DOCKERHUB_IMAGE}:${BUILD_NUMBER}
                            docker push ${DOCKERHUB_IMAGE}:latest
                            echo $NEXUS_PASS | docker login 192.168.161.129:8082 -u $NEXUS_USER --password-stdin
                            docker push ${NEXUS_IMAGE}:${BUILD_NUMBER}
                            docker push ${NEXUS_IMAGE}:latest
                        '''
                    }
                }
            }
        }
    }
    post {
        success {
            echo "CI Pipeline completed. Image pushed: ${BUILD_NUMBER}"
            build job: 'formation-backend-cd',
                  parameters: [string(name: 'IMAGE_TAG', value: "${BUILD_NUMBER}")],
                  wait: false
        }
        failure {
            echo 'CI Pipeline failed — check the logs above.'
        }
    }
}
