pipeline {
    agent any

    environment {
        DOCKERHUB_IMAGE = 'ahmedhoussine/gestion-partner'
    }

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    sh 'mvn clean package -DskipTests -pl GestionPartner -am'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            docker build -f GestionPartner/Dockerfile \
                              -t ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} .

                            docker tag ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} ${DOCKERHUB_IMAGE}:latest

                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin

                            docker push ${DOCKERHUB_IMAGE}:${BUILD_NUMBER}
                            docker push ${DOCKERHUB_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop partner-service || true
                    docker rm partner-service || true

                    docker run -d \
                        --name partner-service \
                        -p 8086:8086 \
                        --network skill2job-network \
                        ${DOCKERHUB_IMAGE}:latest
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'sleep 15'
                sh 'curl -f http://localhost:8086/actuator/health || true'
            }
        }
    }

    post {
        success {
            echo '✅ GestionPartner deployed successfully!'
        }
        failure {
            echo '❌ Pipeline failed'
        }
        always {
            sh 'docker logout || true'
        }
    }
}
