pipeline {
    agent any
    options {
        timeout(time: 60, unit: 'MINUTES')
    }
    environment {
        DOCKERHUB_IMAGE   = 'ahmedhoussine/gestion-partner'
        SONAR_PROJECT_KEY = 'gestion-partner'
        MODULE_PATH       = 'skill2job_pi-skill2job_finale/Back-Skill2job/GestionPartner'
    }
    tools {
        maven 'Maven'
        jdk 'JDK17'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Changes') {
            steps {
                script {
                    def previousCommit = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
                    def changes = sh(
                        script: "git diff --name-only ${previousCommit} HEAD",
                        returnStdout: true
                    ).trim()
                    echo "Changed files:\n${changes}"
                    env.GESTIONPARTNER_CHANGED = changes.contains('GestionPartner') ? 'true' : 'false'
                    if (env.GESTIONPARTNER_CHANGED == 'false') {
                        currentBuild.result = 'NOT_BUILT'
                        error('No changes in GestionPartner — skipping pipeline')
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    sh 'mvn clean package -DskipTests -pl GestionPartner -am'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir("${MODULE_PATH}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName="Gestion Partner"
                        '''
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build & Push') {
            steps {
                dir('skill2job_pi-skill2job_finale/Back-Skill2job') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            docker build \
                              -f GestionPartner/Dockerfile \
                              -t ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} GestionPartner
                            docker tag ${DOCKERHUB_IMAGE}:${BUILD_NUMBER} ${DOCKERHUB_IMAGE}:latest
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            docker push ${DOCKERHUB_IMAGE}:${BUILD_NUMBER}
                            docker push ${DOCKERHUB_IMAGE}:latest
                        '''
                    }
                }
            }
        }
    }
    post {
        success {
            echo '✅ CI OK'
            build job: 'GestionPartner-CD',
                  parameters: [string(name: 'IMAGE_TAG', value: "${BUILD_NUMBER}")],
                  wait: false
        }
        failure {
            echo '❌ CI FAILED'
        }
        aborted {
            echo 'No GestionPartner changes — build skipped.'
        }
        always {
            sh 'docker logout || true'
        }
    }
}
