pipeline {
    agent any
    environment {
        DOCKERHUB_IMAGE = 'ahmedhoussine/gestion-partner'
        K8S_NAMESPACE = 'skill2job'
        K8S_DEPLOYMENT = 'partner-service'
    }
    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy (BUILD_NUMBER from CI)'
        )
    }
    stages {
        stage('Pull Image') {
            steps {
                sh 'docker pull ${DOCKERHUB_IMAGE}:${IMAGE_TAG}'
            }
        }
        stage('Create Namespace') {
            steps {
                sh '''
                    kubectl get namespace ${K8S_NAMESPACE} || \
                    kubectl create namespace ${K8S_NAMESPACE}
                '''
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${K8S_DEPLOYMENT}
  namespace: ${K8S_NAMESPACE}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${K8S_DEPLOYMENT}
  template:
    metadata:
      labels:
        app: ${K8S_DEPLOYMENT}
    spec:
      containers:
      - name: ${K8S_DEPLOYMENT}
        image: ${DOCKERHUB_IMAGE}:${IMAGE_TAG}
        ports:
        - containerPort: 8086
---
apiVersion: v1
kind: Service
metadata:
  name: ${K8S_DEPLOYMENT}
  namespace: ${K8S_NAMESPACE}
spec:
  type: NodePort
  selector:
    app: ${K8S_DEPLOYMENT}
  ports:
  - port: 8086
    targetPort: 8086
    nodePort: 30086
EOF
                '''
            }
        }
        stage('Wait for Rollout') {
            steps {
                sh '''
                    kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                        -n ${K8S_NAMESPACE} \
                        --timeout=120s
                '''
            }
        }
        stage('Health Check') {
            steps {
                sh 'sleep 15'
                sh '''
                    NODE_IP=$(kubectl get nodes -o jsonpath="{.items[0].status.addresses[0].address}")
                    curl -f http://${NODE_IP}:30086/actuator/health || true
                '''
            }
        }
    }
    post {
        success {
            echo '✅ GestionPartner deployed successfully to Kubernetes!'
        }
        failure {
            echo '❌ CD Pipeline failed'
            sh '''
                kubectl rollout undo deployment/${K8S_DEPLOYMENT} \
                    -n ${K8S_NAMESPACE} || true
            '''
        }
    }
}
