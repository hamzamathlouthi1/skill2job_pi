pipeline {
    agent any
    environment {
        DOCKERHUB_IMAGE = 'ahmedhoussine/gestion-partner'
        K8S_NAMESPACE = 'skill2job'
        K8S_DEPLOYMENT = 'partner-service'
    }
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest')
    }
    stages {
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${K8S_DEPLOYMENT}
  namespace: ${K8S_NAMESPACE}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${K8S_DEPLOYMENT}
  template:
    metadata:
      labels:
        app: ${K8S_DEPLOYMENT}
    spec:
      containers:
      - name: ${K8S_DEPLOYMENT}
        image: ${DOCKERHUB_IMAGE}:${IMAGE_TAG}
        ports:
        - containerPort: 8086
        readinessProbe:
          httpGet:
            path: /actuator/health
            port: 8086
          initialDelaySeconds: 15
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /actuator/health
            port: 8086
          initialDelaySeconds: 30
          periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: ${K8S_DEPLOYMENT}
  namespace: ${K8S_NAMESPACE}
spec:
  type: NodePort
  selector:
    app: ${K8S_DEPLOYMENT}
  ports:
  - port: 8086
    targetPort: 8086
    nodePort: 30086
EOF
                '''
            }
        }
        stage('Wait Rollout') {
            steps {
                sh '''
                    kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                    -n ${K8S_NAMESPACE} --timeout=120s
                '''
            }
        }
        stage('Health Check') {
            steps {
                sh '''
                    set -e
                    NODE_IP=$(kubectl get nodes -o jsonpath="{.items[0].status.addresses[0].address}")
                    curl -f --max-time 5 http://${NODE_IP}:30086/actuator/health
                '''
            }
        }
    }
    post {
        success {
            echo '✅ DEPLOY OK'
        }
        failure {
            echo '❌ DEPLOY FAILED'
            sh '''
                kubectl rollout undo deployment/${K8S_DEPLOYMENT} \
                -n ${K8S_NAMESPACE} || true
            '''
        }
    }
}
